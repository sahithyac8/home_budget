# Copy this file to .env and fill it in. .env is NOT uploaded to GitHub. Never commit real passwords.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DB=home_budget
SECRET_KEY=change-me-too          # long random text; it signs the login cookie (see docs/DEPLOYMENT.md)
CURRENCY=₹
# --- only for the live website (see docs/DEPLOYMENT.md) ---
# MYSQL_SSL_CA=ca.pem             # certificate file from your hosted MySQL service
# SESSION_COOKIE_SECURE=1         # send the login cookie only over HTTPS
# FLASK_DEBUG=1   # only on your own machine, never during the demonstration
